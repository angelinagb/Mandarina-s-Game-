arreglo_de_textos = PackedStringArray("Unos tontos se burlaron de mi por ser muy lento para resolver sus acertijos", "Dijieron que es genético y que toda mi familia es igual de tonta que yo", "¿Podrías hacerte pasar por mi y vencerlos?", "Le pediría ayuda a mi hermano mayor pero recien me aviso que le erro de parada y va a llegar tarde")
