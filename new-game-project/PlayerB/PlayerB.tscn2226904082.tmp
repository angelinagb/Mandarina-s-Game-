[sub_resource type="GDScript" id="GDScript_akjgv"]
script/source = "class_name PlayerB
extends CharacterBody2D

@export var SPEED = 300.0

@onready var sprite = $AnimatedSprite2D
@onready var this = $\".\"
var last_direction = Vector2(0, 1) 


func _ready(): 
	sprite.play(\"idle_east\") 


# 🔸 Función para determinar qué animación usar en 4 direcciones
func update_animation_parameters(dir: Vector2, state: String):
	var anim = \"\"

	if dir.x == 0 and dir.y == -1:
		anim = \"_west\" #315
	elif dir.x == 0 and dir.y == 1:
		anim = \"_east\"#143
	elif dir.x == -1 and dir.y == 0:
		anim = \"_south\" #247
	elif dir.x == 1 and dir.y == 0:
		anim = \"_north\" #67

	sprite.play(state + anim)

func get_last_dir() -> Vector2 : 
	return last_direction
	
func update_last_dir(new_dir : Vector2) -> void : 
	last_direction = new_dir
	
"

