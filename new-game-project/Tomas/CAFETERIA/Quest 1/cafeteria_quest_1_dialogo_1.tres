[resource]
script = ExtResource("1_bgs3m")
arreglo_de_textos = PackedStringArray("Hola, ¿Qué vas a llevar?", "¿Una tesis? ¿Qué mandarina hizo qué?", "Disculpa pero no me importa, ¿vas a comprar o no?", "No me hagas perder el tiempo", "...", "Sabes que disculpa, te estoy hablando muy mal, estoy muy estresado para poder ayudarte", "Me esta faltando stock todos los días y me esta volviendo loco porque no se por qué pasa", "Que tal esto, si me ayudas con mi problema yo intento ayudarte como pueda con tu tesis", "¿Qué te parece?", "Quest comenzada: Stock faltante")
tiempo_entre_caracteres = 0.02
metadata/_custom_type_script = "uid://dekceg47jr41c"
