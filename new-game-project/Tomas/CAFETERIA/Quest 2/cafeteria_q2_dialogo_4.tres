[ext_resource type="Script" uid="uid://dekceg47jr41c" path="res://managers/dialogue 2.0/recursos/scripts/Dialogo.gd" id="1_8wdnu"]

[resource]
script = ExtResource("1_8wdnu")
arreglo_de_textos = PackedStringArray("Se fueron corriendo asustados, no creo que vuelvan a intentar robar otra vez", "Te lo agradezco, me sacaste un gran estrés de encima.", "Hoy, me contó un profesor que un alumno que quería unirse a esta banda de ladrones", "Los quería impresionar diciendo que se robo una tesis de un alumno pero no le creyeron", "Capaz pase por acá pensando que ellos van a volver, seguro la tenga encima", "Esperemos un cachito para ver si viene, ¿dale?")
tiempo_entre_caracteres = 0.02
metadata/_custom_type_script = "uid://dekceg47jr41c"
