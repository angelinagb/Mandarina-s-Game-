script = ExtResource("1_ethko")
arreglo_de_textos = PackedStringArray("Segun las camaras, mandarina paso por aca con mi tesis.", "Supongo que un gato es mejor que la nube", "Bueno...¿Ahora que?", "Debería preguntar al vendedor si sabe algo al respecto", "Aunque me dijieron que es muy cerrado y poco sociable", "Voy a tener que ganarme su confianza")
